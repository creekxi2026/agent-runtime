# 下载/复制为 .env；不要覆盖已有凭据文件。每个实例使用唯一名称。
COMPOSE_PROJECT_NAME=agent-user01
RUNTIME_IMAGE=ghcr.io/creekxi2026/agent-runtime:latest
# 私有 HOME 命名卷；留空默认 <COMPOSE_PROJECT_NAME>-home，不与其他实例共用。
HOME_VOLUME=
# bind HOME 必须启用 compose.bind-home.yaml；仅设置 HOME_DIR 不会迁移旧数据。
# HOME_DIR=./home
CPU_LIMIT=2
MEMORY_LIMIT=4g
# 可选：覆盖 Multica 原生默认值，与页面 Agent 并发限制独立。
# MULTICA_DAEMON_MAX_CONCURRENT_TASKS=20

# 留空连接 Multica Cloud；自托管填写服务地址。
MULTICA_SERVER_URL=
MULTICA_APP_URL=

# 可选只读共享 API Key 配置；启用 compose.shared-codex.yaml，不共享整个 .codex。
# SHARED_CODEX_DIR=../shared-codex
# 可选共享下载缓存；启用 compose.shared-cache.yaml，仅供相互信任的 Linux 容器。
# SHARED_CACHE_VOLUME=agent-runtime-download-cache
# 缓存 bind 另加 compose.shared-cache.bind.yaml，放在 shared-cache 配置之后。
# SHARED_CACHE_DIR=../shared/caches
# 基础文件在前，bind override 在对应命名卷配置之后；Windows 用 ; 分隔，组合见 README。
# COMPOSE_FILE=compose.yaml:compose.shared-cache.yaml

# Multica 可留空并交互登录；Lark 应用配置按需填写。真实值用单引号包围，勿提交或分享。
MULTICA_BOOTSTRAP_TOKEN=
LARK_APP_ID=
LARK_APP_SECRET=
LARK_BRAND=feishu
