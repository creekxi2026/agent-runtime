# 下载/复制后命名为 runtime.env，无需隐藏文件。
COMPOSE_PROJECT_NAME=agent-user01
IMAGE=ghcr.io/creekxi2026/agent-runtime:0.1.0
CPU_LIMIT=2
MEMORY_LIMIT=4g
MAX_CONCURRENT_TASKS=1

# 默认连接 Multica Cloud；自托管填写地址。
MULTICA_SERVER_URL=
MULTICA_APP_URL=

# 可留空，改用 README 中的交互登录。只使用该用户自己的凭据。
# 真实值用单引号包围，避免 $ 插值；勿提交 Git或发回聊天。
# 登录后可清空凭据并重建容器；登录状态仍保存在该用户数据卷中。
MULTICA_BOOTSTRAP_TOKEN=
CODEX_BOOTSTRAP_API_KEY=
LARK_APP_ID=
LARK_APP_SECRET=
LARK_BRAND=feishu

# 可选：独立 Mac Playwright 浏览器的 WebSocket 地址，非 MCP/CDP。
PLAYWRIGHT_WS_ENDPOINT=
