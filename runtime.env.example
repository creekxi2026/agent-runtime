# Copy/download as .env; do not overwrite credentials. Use a unique instance name.
COMPOSE_PROJECT_NAME=agent-user01
RUNTIME_IMAGE=ghcr.io/creekxi2026/agent-runtime:latest
# Private HOME volume; blank defaults to <COMPOSE_PROJECT_NAME>-home. Never share it.
HOME_VOLUME=
# Bind HOME requires compose.bind-home.yaml; HOME_DIR alone does not migrate data.
# HOME_DIR=./home
CPU_LIMIT=2
MEMORY_LIMIT=4g
# Leave unset to let Multica choose daemon concurrency automatically.
# The per-Agent limit is a server setting: agent-setup.md uses
# `multica agent create ... --max-concurrent-tasks 50`, not an image/env default.
# MULTICA_DAEMON_MAX_CONCURRENT_TASKS=20

# Go module proxy; alternatively use https://goproxy.cn,direct.
# Comma fallback applies only to HTTP 404/410, not timeouts or other errors.
GOPROXY=https://proxy.golang.org,direct
# Keep checksum verification enabled for public modules.
GOSUMDB=sum.golang.org
# Optional private module path patterns; bypass the proxy and checksum database.
GOPRIVATE=

# Leave blank for Multica Cloud; set endpoints for self-hosting.
# The daemon applies these at startup. Before an interactive login, set the URLs
# inside the new instance with `multica config set` as shown in the README.
MULTICA_SERVER_URL=
MULTICA_APP_URL=

# Optional: share only config.toml and auth.json from an authorized host Codex directory.
# Download compose.shared-codex-files.yaml first. API keys only; otherwise use private login.
# Use the Docker host's path; ${HOME} below assumes Docker runs on this machine.
# SHARED_CODEX_DIR=${HOME}/.codex
# COMPOSE_FILE=compose.yaml:compose.shared-codex-files.yaml
# Recreate the container after the host atomically replaces either file.

# Optional: share downloads through a Docker-managed volume, including on OrbStack.
# Download compose.shared-cache.yaml first. No host cache directory is needed.
# SHARED_CACHE_VOLUME=agent-runtime-download-cache
# COMPOSE_FILE=compose.yaml:compose.shared-cache.yaml
# If enabling both options, combine the overrides in ONE COMPOSE_FILE assignment.
# Base file first; Windows uses ; instead of :. Other storage options are in README.

# Multica login token, NOT a model API key. Leave blank when logging in interactively.
# Single-quote real secrets in a private .env; never share or commit them.
MULTICA_BOOTSTRAP_TOKEN=
# Lark configuration is optional; user authorization is still required.
LARK_APP_ID=
LARK_APP_SECRET=
LARK_BRAND=feishu
