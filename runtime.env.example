# 下载/复制后命名为 .env；已有环境文件不要直接覆盖。
COMPOSE_PROJECT_NAME=agent-user01
RUNTIME_IMAGE=ghcr.io/creekxi2026/agent-runtime:latest
# 私有命名卷；留空默认 <COMPOSE_PROJECT_NAME>-home。
HOME_VOLUME=
# 仅 compose.bind-home.yaml 使用；普通命名卷部署无需 HOME_DIR。
# HOME_DIR=./home
CPU_LIMIT=2
MEMORY_LIMIT=4g
# 可选：仅需覆盖 Multica 原生并发默认值时取消注释。
# MULTICA_DAEMON_MAX_CONCURRENT_TASKS=20

# 默认连接 Multica Cloud；自托管填写地址。
MULTICA_SERVER_URL=
MULTICA_APP_URL=

# 可选共享配置：配合 compose.shared-codex.yaml 启用。
# SHARED_CODEX_DIR=../shared-codex
# 可选下载缓存：配合 compose.shared-cache.yaml，仅供可信 Linux 容器。
# SHARED_CACHE_VOLUME=agent-runtime-download-cache
# 仅 compose.shared-cache.bind.yaml 使用。
# SHARED_CACHE_DIR=../shared/caches
# COMPOSE_FILE=compose.yaml:compose.shared-cache.yaml

# 个人凭据可留空并交互登录；真实值用单引号包围，勿提交或分享。
MULTICA_BOOTSTRAP_TOKEN=
LARK_APP_ID=
LARK_APP_SECRET=
LARK_BRAND=feishu
